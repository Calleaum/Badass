# routeur-calleaum-1 : VXLAN en mode groupe (multicast dynamique)
ip addr add 10.1.1.1/24 dev eth0
ip link set eth0 up
ip link add br0 type bridge
ip link set br0 up

# Pas de remote : les VTEP se trouvent via le groupe multicast 239.1.1.1
ip link add vxlan10 type vxlan id 10 dstport 4789 group 239.1.1.1 dev eth0
ip link set vxlan10 up
ip link set eth1 up
brctl addif br0 eth1
brctl addif br0 vxlan10