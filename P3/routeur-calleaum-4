# routeur-calleaum-4 : leaf (VTEP), host-3 sur eth0
# 1) IP
ip addr add 1.1.1.4/32 dev lo
ip addr add 10.1.1.10/30 dev eth2    # vers le RR
ip link set eth2 up

# 2) Bridge + VXLAN 10
ip link add br0 type bridge
ip link set br0 up
ip link add vxlan10 type vxlan id 10 dstport 4789 local 1.1.1.4 nolearning
ip link set vxlan10 up
ip link set eth0 up
brctl addif br0 vxlan10
brctl addif br0 eth0                 # côté host

# 3) FRR
vtysh << 'EOF'
configure terminal
router ospf
 network 1.1.1.4/32 area 0
 network 10.1.1.0/24 area 0
exit
router bgp 1
 neighbor 1.1.1.1 remote-as 1
 neighbor 1.1.1.1 update-source lo
 address-family l2vpn evpn
  neighbor 1.1.1.1 activate
  advertise-all-vni
 exit-address-family
end
EOF
