# routeur-calleaum-2 : leaf (VTEP), host-1 sur eth1
# 1) IP
ip addr add 1.1.1.2/32 dev lo
ip addr add 10.1.1.2/30 dev eth0     # vers le RR
ip link set eth0 up

# 2) Bridge + VXLAN 10 (pas de remote/group : BGP EVPN, nolearning)
ip link add br0 type bridge
ip link set br0 up
ip link add vxlan10 type vxlan id 10 dstport 4789 local 1.1.1.2 nolearning
ip link set vxlan10 up
ip link set eth1 up
brctl addif br0 vxlan10
brctl addif br0 eth1                 # côté host

# 3) FRR : OSPF + iBGP EVPN vers le RR
vtysh << 'EOF'
configure terminal
router ospf
 network 1.1.1.2/32 area 0
 network 10.1.1.0/24 area 0
exit
router bgp 1
 neighbor 1.1.1.1 remote-as 1
 neighbor 1.1.1.1 update-source lo
 address-family l2vpn evpn
  neighbor 1.1.1.1 activate
  advertise-all-vni
 exit-address-family
end
EOF
